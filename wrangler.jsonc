{
  // Cloudflare Workers (free plan): the React site is served as static assets, /api/* runs the Express API in the Worker.
  "name": "cloudy-toy",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application", // unknown paths (e.g. /admin, /cart) open the React app
    "run_worker_first": ["/api/*"]                    // only API calls wake the Worker; pages and images are free static files
  },
  "images": { "binding": "IMAGES" },                  // resizing of uploaded photos (replaces the sharp library)
  "alias": {
    "sharp": "./server/lib/sharp-stub.ts",           // sharp is native code and cannot run on Workers
    "iconv-lite": "./server/lib/iconv-stub.ts"       // real iconv-lite crashes at startup in the Worker bundle (error 10021)
  },
  "observability": { "enabled": true }
}
