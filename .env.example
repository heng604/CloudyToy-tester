# Copy to .env.local. (Your old Next.js .env.local also works as-is: NEXT_PUBLIC_* names are still read.)
# NEVER commit real values.

# --- browser (public) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Google button is ON by default. Set to false to hide it.
VITE_GOOGLE_LOGIN=true
# Sign in again after this many hours (24 = every day, 168 = every week). Empty or 0 = stay signed in until sign-out.
VITE_SESSION_HOURS=
# Optional fallbacks for the Contact/Cart Telegram button and contact email (normally set in Admin > Settings)
VITE_TELEGRAM_URL=
VITE_ADMIN_NOTIFICATION_EMAIL=toyscloudy@gmail.com

# --- server only (never exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
RESEND_API_KEY=your-resend-api-key
ADMIN_NOTIFICATION_EMAIL=toyscloudy@gmail.com
# IMPORTANT (so mail does NOT go to spam): verify your own domain in Resend (resend.com/domains, add the SPF + DKIM DNS records),
# then use an address on that domain, e.g. EMAIL_FROM=Cloudy-Toy <orders@yourdomain.com>.
# Gmail/Yahoo addresses cannot be used as the sender: the app falls back to Resend's test sender, which only delivers to your own Resend account email and is often marked as spam.
EMAIL_FROM=Cloudy-Toy <orders@yourdomain.com>
# Public address of your shop (no trailing slash). Used for the logo and the "View my invoice" button in customer e-mails.
SITE_URL=https://yourdomain.com
PORT=3001
# Bakong KHQR (scan-to-pay with automatic confirmation). Leave empty to hide the option at checkout.
# BAKONG_ACCOUNT_ID = the Bakong account that receives the money, e.g. yourname@aba (shown in your bank app's KHQR profile)
# BAKONG_API_TOKEN  = Bakong Open API token: register at https://api-bakong.nbc.gov.kh/register (needs a Cambodian phone/email; tokens expire, renew when needed)
BAKONG_ACCOUNT_ID=
BAKONG_API_TOKEN=
BAKONG_MERCHANT_NAME=Cloudy Toys
BAKONG_MERCHANT_CITY=Phnom Penh
# Bakong only answers from Cambodian IP addresses. If your website is hosted outside Cambodia (e.g. Vercel), payments are confirmed by a small watcher on a computer in Cambodia:
#   1) put the SAME BAKONG_WATCHER_SECRET (any long random text, 12+ characters) in Vercel's environment variables AND in this file on the shop PC
#   2) BAKONG_SITE_URL = your website address (used only by the watcher on the shop PC)
#   3) double-click start-bakong-watcher.bat and keep it running while you take payments
BAKONG_WATCHER_SECRET=
BAKONG_SITE_URL=

# --- Cloudflare R2 image storage (server only; free plan: 10 GB, 1M writes, 10M reads per month) ---
# Leave all five empty to keep using Supabase Storage. Fill all five to send NEW uploads to R2 (old images keep working from Supabase).
# R2_ACCOUNT_ID    = the long code in your Cloudflare dashboard address: dash.cloudflare.com/<THIS-CODE>/r2/overview
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY = from R2 > Manage API Tokens > Create Account API token (Object Read & Write). The secret is shown only once.
# R2_BUCKET        = bucket name, e.g. cloudy-toy-images
# R2_PUBLIC_URL    = bucket > Settings > Public Development URL (https://pub-xxxx.r2.dev), or your custom domain. No trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cloudy-toy-images
R2_PUBLIC_URL=
